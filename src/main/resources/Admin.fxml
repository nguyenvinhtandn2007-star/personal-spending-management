<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="650.0" prefWidth="760.0" spacing="10.0" style="-fx-padding: 12;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AdminController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button mnemonicParsing="false" onAction="#quayLai" text="Quay lai" />
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Quan tri he thong" />
        </HBox>

        <Label style="-fx-font-weight: bold;" text="Quan ly tai khoan" />
        <TableView fx:id="tblTaiKhoan" prefHeight="180.0">
            <columns>
                <TableColumn fx:id="colUserId" prefWidth="70.0" text="ID" />
                <TableColumn fx:id="colUsername" prefWidth="160.0" text="Ten dang nhap" />
                <TableColumn fx:id="colFullName" prefWidth="220.0" text="Ho ten" />
                <TableColumn fx:id="colRole" prefWidth="120.0" text="Vai tro" />
            </columns>
        </TableView>
        <HBox spacing="8.0">
            <TextField fx:id="txtUsername" promptText="Ten dang nhap" />
            <PasswordField fx:id="txtPassword" promptText="Mat khau khi them" />
            <TextField fx:id="txtFullName" promptText="Ho ten" />
            <ComboBox fx:id="cbRole" prefWidth="100.0" />
            <Button mnemonicParsing="false" onAction="#themTaiKhoan" text="Them" />
            <Button mnemonicParsing="false" onAction="#capNhatTaiKhoan" text="Sua" />
            <Button mnemonicParsing="false" onAction="#xoaTaiKhoan" text="Xoa" />
        </HBox>

        <Label style="-fx-font-weight: bold;" text="Quan ly danh muc" />
        <TableView fx:id="tblDanhMuc" prefHeight="180.0">
            <columns>
                <TableColumn fx:id="colCategoryId" prefWidth="90.0" text="ID" />
                <TableColumn fx:id="colCategoryName" prefWidth="360.0" text="Ten danh muc" />
            </columns>
        </TableView>
        <HBox spacing="8.0">
            <TextField fx:id="txtTenDanhMuc" prefWidth="260.0" promptText="Ten danh muc" />
            <Button mnemonicParsing="false" onAction="#themDanhMuc" text="Them" />
            <Button mnemonicParsing="false" onAction="#capNhatDanhMuc" text="Sua" />
            <Button mnemonicParsing="false" onAction="#xoaDanhMuc" text="Xoa" />
        </HBox>
    </children>
</VBox>
