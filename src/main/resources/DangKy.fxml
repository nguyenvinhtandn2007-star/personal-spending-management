<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="350.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DangKyController">
    <children>
        <Label text="ĐĂNG KÝ TÀI KHOẢN" textFill="blue">
            <font>
                <Font name="System" size="20.0" />
            </font>
        </Label>
        <VBox spacing="5.0">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
            <children>
                <Label text="Họ tên:" />
                <TextField fx:id="txtHoTen" />

                <Label text="Tên đăng nhập:" />
                <TextField fx:id="txtTenDangNhap" />

                <Label text="Mật khẩu:" />
                <PasswordField fx:id="txtMatKhau" />

                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#xuLyDangKy" style="-fx-background-color: blue; -fx-text-fill: white;" text="Đăng Ký">
                    <font>
                        <Font name="System" size="14.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>

                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quayLaiDangNhap" text="Quay lại Đăng nhập" />
            </children>
        </VBox>
    </children>
</VBox>