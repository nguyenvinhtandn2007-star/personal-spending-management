<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="350.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.QuenMatKhauController">
    <children>
        <Label text="DAT LAI MAT KHAU" textFill="blue">
            <font>
                <Font name="System" size="22.0" />
            </font>
        </Label>
        <VBox spacing="8.0">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
            <children>
                <Label text="Ten dang nhap:" />
                <TextField fx:id="txtTenDangNhap" />
                <Label text="Ho ten da dang ky:" />
                <TextField fx:id="txtHoTen" />
                <Label text="Mat khau moi:" />
                <PasswordField fx:id="txtMatKhauMoi" />
                <Label text="Nhap lai mat khau moi:" />
                <PasswordField fx:id="txtNhapLaiMatKhau" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#xuLyDatLaiMatKhau" style="-fx-background-color: blue; -fx-text-fill: white;" text="Dat lai mat khau">
                    <font>
                        <Font name="System" size="14.0" />
                    </font>
                </Button>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quayLaiDangNhap" text="Quay lai dang nhap" />
            </children>
        </VBox>
    </children>
</VBox>
