<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ThemGiaoDichController">
    <top>
        <VBox alignment="CENTER" style="-fx-padding: 10; -fx-background-color: lightgray;">
            <Label text="THÊM MỚI">
                <font>
                    <Font name="System" size="16.0" />
                </font>
            </Label>
        </VBox>
    </top>
    <center>
        <VBox spacing="10.0" style="-fx-padding: 15;">
            <Label text="Số tiền:" />
            <TextField fx:id="tfTien" promptText="0" />

            <HBox spacing="10.0">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Loại:" />
                    <ComboBox fx:id="cbLoai" maxWidth="Infinity" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Danh mục:" />
                    <ComboBox fx:id="cbDM" maxWidth="Infinity" />
                </VBox>
            </HBox>

            <Label text="Ngày giờ:" />
            <HBox spacing="5.0">
                <DatePicker fx:id="dp" />
                <Spinner fx:id="spGio" prefWidth="60" />
                <Label text=":" />
                <Spinner fx:id="spPhut" prefWidth="60" />
            </HBox>

            <Label text="Ghi chú:" />
            <TextArea fx:id="taGhiChu" prefHeight="80.0" wrapText="true" />
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 15;">
            <Button onAction="#quayLaiTrangChu" prefWidth="80.0" text="Hủy" />
            <Button onAction="#xuLyThemGiaoDich" prefWidth="120.0" style="-fx-background-color: blue; -fx-text-fill: white;" text="Lưu">
                <font>
                    <Font name="System" size="14.0" />
                </font>
            </Button>
        </HBox>
    </bottom>
</BorderPane>