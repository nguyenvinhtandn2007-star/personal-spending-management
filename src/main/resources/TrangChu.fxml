<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TrangChuController">
    <children>
        <BorderPane>
            <top>
                <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 10; -fx-background-color: lightgray;">
                    <Label fx:id="lblXinChao" text="Xin chao" textFill="gray">
                        <font>
                            <Font name="System" size="14.0" />
                        </font>
                    </Label>

                    <Label text="DANH SACH GIAO DICH" textFill="blue">
                        <font>
                            <Font name="System" size="16.0" />
                        </font>
                    </Label>

                    <HBox alignment="CENTER" spacing="5.0">
                        <TextField fx:id="txtTimKiem" prefWidth="120.0" promptText="Tu khoa" />
                        <Button mnemonicParsing="false" onAction="#xuLyTimKiem" text="Tim" />
                        <Button mnemonicParsing="false" onAction="#exportCsv" text="Export" />
                        <Button mnemonicParsing="false" onAction="#importCsv" text="Import" />
                    </HBox>
                </VBox>
            </top>
            <center>
                <ScrollPane fitToWidth="true">
                    <content>
                        <VBox fx:id="vboxDanhSach" spacing="10.0" style="-fx-padding: 10;" />
                    </content>
                </ScrollPane>
            </center>
            <bottom>
                <HBox alignment="CENTER" spacing="18" style="-fx-padding: 10; -fx-border-color: gray; -fx-border-width: 1 0 0 0;">
                    <VBox fx:id="btnLichSu" alignment="CENTER">
                        <Label style="-fx-text-fill: blue;" text="Lich su" />
                    </VBox>

                    <Button fx:id="btnThem" style="-fx-background-color: blue; -fx-text-fill: white;" text="Them moi">
                        <font>
                            <Font name="System" size="14.0" />
                        </font>
                    </Button>

                    <VBox fx:id="btnBaoCao" alignment="CENTER">
                        <Label text="Bao cao" />
                    </VBox>

                    <Button fx:id="btnQuanTri" mnemonicParsing="false" onAction="#moQuanTri" text="Quan tri" />
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</StackPane>
