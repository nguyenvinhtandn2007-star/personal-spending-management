<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TrangChuController">
    <children>
        <BorderPane>
            <top>
                <VBox alignment="CENTER" style="-fx-padding: 10; -fx-background-color: lightgray;">
                    <Label fx:id="lblXinChao" text="Xin chào" textFill="gray">
                        <font>
                            <Font name="System" size="14.0" />
                        </font>
                        <VBox.margin>
                            <Insets bottom="5.0" />
                        </VBox.margin>
                    </Label>

                    <Label text="DANH SÁCH GIAO DỊCH" textFill="blue">
                        <font>
                            <Font name="System" size="16.0" />
                        </font>
                    </Label>
                </VBox>
            </top>
            <center>
                <ScrollPane fitToWidth="true">
                    <content>
                        <VBox fx:id="vboxDanhSach" spacing="10.0" style="-fx-padding: 10;" />
                    </content>
                </ScrollPane>
            </center>
            <bottom>
                <HBox alignment="CENTER" spacing="30" style="-fx-padding: 10; -fx-border-color: gray; -fx-border-width: 1 0 0 0;">

                    <VBox fx:id="btnLichSu" alignment="CENTER">
                        <Label text="Lịch sử" style="-fx-text-fill: blue;" />
                    </VBox>

                    <Button fx:id="btnThem" text="Thêm Mới" style="-fx-background-color: blue; -fx-text-fill: white;">
                        <font>
                            <Font name="System" size="14.0" />
                        </font>
                    </Button>

                    <VBox fx:id="btnBaoCao" alignment="CENTER">
                        <Label text="Báo cáo" />
                    </VBox>

                </HBox>
            </bottom>
        </BorderPane>
    </children>
</StackPane>